<Window x:Class="WardenCli.Views.MapNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export the explored map" SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <!-- THE EXPORTED MAP'S NAME (propuesta 120; Juan, 20-oct-2026: "el botón de export map debe pedirme el nombre que quiero setearle y que se
         validen no existan otros iguales"): the name the golem's new scenario gets — a name for the line (letters, digits, hyphens) and none
         the golem knows already; the console checks against the maps it read, the golem refuses a repeat too. -->
    <StackPanel Margin="14">
        <TextBlock x:Name="Prompt" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="name" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="NameBox" TextChanged="Name_Changed"/>
        </DockPanel>
        <TextBlock x:Name="Problem" Foreground="{StaticResource Red}" Margin="2,8,2,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="Known" Foreground="{StaticResource Dim}" FontSize="11" Margin="2,6,2,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ExportButton" Content="export" Click="Export_Click" IsDefault="True" Style="{StaticResource GoGreen}" Padding="18,6"/>
            <Button Content="cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
