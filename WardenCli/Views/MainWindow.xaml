<Window x:Class="WardenCli.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WardenCli.Views"
        Title="WardenCli — the operator's console" Height="860" Width="1400" MinHeight="640" MinWidth="1060"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- a golem in the list: a box in its colour, like the sketch -->
        <DataTemplate x:Key="GolemBox">
            <Border x:Name="Box" BorderThickness="3" CornerRadius="3" Margin="4,3" Padding="6,4" Background="{StaticResource Well}" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}" Opacity="0.7"
                    ToolTip="click: this golem's script in the centre · check: addressed by 'selected'">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="selected: send and paste go to the selected golems"/>
                    <TextBlock x:Name="Marker" DockPanel.Dock="Right" Text="▶ script" Visibility="Collapsed" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource Ink}"><Run Text="{Binding Name}"/><Run Text="  "/><Run x:Name="Addr" Text="{Binding Address, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11" FontWeight="Normal"/></TextBlock>
                        <TextBlock Text="{Binding StatusLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="Seen" Text="{Binding LastSeen, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- the box whose script is in the centre: tinted in its golem's colour, its border a little thicker, a "script" tag in the accent;
                 the others dimmed (Juan, 7-oct-2026: "destacar el golem seleccionado… no se nota aún" — then, on a white border and a glow: "muy exagerado") -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="1"/>
                    <Setter TargetName="Box" Property="Background" Value="{Binding Name, Converter={x:Static local:GolemColor.Fill}}"/>
                    <Setter TargetName="Box" Property="BorderThickness" Value="4"/>
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Addr" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Seen" Property="Foreground" Value="{StaticResource Ink}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ScriptOf">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"><Run Text="the script for "/><Run Text="{Binding Name}" FontWeight="Bold" Foreground="#e6e1cf"/><Run Text=" — one command per line, sent in order; a line starting with # is a note"/></TextBlock>
                <!-- THE SEND COLUMN (Juan, 7-oct-2026: "sólo enviar a los selected… el stop debajo y posiciónalos hasta abajo"): one SEND, to the
                     checked golems, at the foot of the column with stop under it; which golems go is said by the checks, never by a button -->
                <DockPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Margin="4,4" Foreground="{StaticResource Dim}" TextWrapping="Wrap"><Run Text="sent "/><Run Text="{Binding Sent}"/><Run Text=" command(s) this session"/></TextBlock>
                    <Button DockPanel.Dock="Bottom" Content="SEND to selected" Click="SendSelected_Click" Height="56" FontSize="15" FontWeight="Bold" Style="{StaticResource GoGreen}" ToolTip="the queue of every checked golem, each its own, line by line; they wait for each other at @sync"/>
                    <Button DockPanel.Dock="Bottom" Content="stop" Margin="2,2,2,4" Click="StopSelected_Click" ToolTip="the checked golems that are sending stop; the rest of each queue stays on its tab"/>
                </DockPanel>
                <!-- ABOVE THE SCRIPT: what the golem can be told (Juan, 6-oct-2026: "algunos botones siempre por arriba y al centro el comando") -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,0,4">
                    <WrapPanel>
                        <TextBlock Text="errands" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <Button Content="visit" Tag="visit {point}" Click="Compose_Click" ToolTip="visit x,y — go there, through every point picked on the map"/>
                        <Button Content="cover" Tag="cover {point}" Click="Compose_Click" ToolTip="cover x,y — the way decided at once"/>
                        <Button Content="then" Tag="then {point}" Click="Compose_Click" ToolTip="then x,y — one more stop on the route underway"/>
                        <TextBlock Text="hold" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Button Content="pause" Tag="pause" Click="Compose_Click"/>
                        <Button Content="resume" Tag="resume" Click="Compose_Click"/>
                    </WrapPanel>
                </Border>
                <!-- BELOW THE SCRIPT: the golem's own choreography module (the fleet agrees among itself) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                    <WrapPanel>
                        <TextBlock Text="its own choreography · centre: the point of the box" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <Button Content="square · by rank" Tag="choreograph square --center {point} --side 2.0 --by rank" Click="Compose_Click"/>
                        <Button Content="square · by distance" Tag="choreograph square --center {point} --side 2.0 --by distance" Click="Compose_Click"/>
                        <Button Content="pentagon · by distance" Tag="choreograph pentagon --center {point} --side 2.0 --by distance" Click="Compose_Click"/>
                        <Button Content="↻ clockwise" Tag="rotate clockwise" Click="Compose_Click"/>
                        <Button Content="↺ counter-clockwise" Tag="rotate counterclockwise" Click="Compose_Click"/>
                    </WrapPanel>
                </Border>
                <Border BorderThickness="3,0,0,0" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}">
                    <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Margin="0"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap"/>
                </Border>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="642"/>
            <ColumnDefinition x:Name="DebuggerColumn" Width="*" MinWidth="330"/>
        </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
        <!-- THE RIBBON: our own, dark — tabs of groups of big buttons; every button composes a command on the current golem's tab -->
        <TabControl DockPanel.Dock="Top" x:Name="Ribbon" Style="{StaticResource RibbonTabs}" Height="152">
            <TabItem Header="Workspace">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="workspace" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="New" local:Look.Glyph="✧" Click="NewWorkspace_Click" ToolTip="a clean window: no golems, no scripts"/>
                            <Button Style="{StaticResource Big}" Content="Open…" local:Look.Glyph="📂" Click="OpenWorkspace_Click" ToolTip="a workspace folder: the golems, their queues, the routines"/>
                            <Button Style="{StaticResource Big}" Content="Save" local:Look.Glyph="💾" Click="SaveWorkspace_Click"/>
                            <Button Style="{StaticResource Big}" Content="Save as…" local:Look.Glyph="💾" local:Look.Tint="{StaticResource Accent}" Click="SaveWorkspaceAs_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="recent workspaces — click to switch" Style="{StaticResource RibbonGroup}">
                        <WrapPanel x:Name="RecentPanel" Orientation="Vertical" MaxHeight="96" VerticalAlignment="Top">
                            <TextBlock Text="none yet" Foreground="{StaticResource Dim}" Margin="4"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="program" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="About" local:Look.Glyph="ⓘ" Click="About_Click"/>
                            <Button Style="{StaticResource Big}" Content="Exit" local:Look.Glyph="⏻" local:Look.Tint="{StaticResource Red}" Click="Exit_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Console" IsSelected="True">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="clipboard" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Paste" local:Look.Glyph="📋" Click="Paste_Click" ToolTip="appends the clipboard's lines to this tab's script"/>
                            <Button Style="{StaticResource Big}" Content="Copy script" local:Look.Glyph="⎘" Click="Copy_Click" ToolTip="this tab's script to the clipboard"/>
                            <Button Style="{StaticResource Big}" Content="To selected" local:Look.Glyph="⇶" local:Look.Tint="{StaticResource Blue}" Click="CopyToSelected_Click" ToolTip="appends this tab's script to every checked golem's tab"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="routine files" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Save routine" local:Look.Glyph="💾" Click="SaveRoutine_Click" ToolTip="this tab's script as a .routine file"/>
                            <Button Style="{StaticResource Big}" Content="Load here" local:Look.Glyph="📂" Click="LoadRoutine_Click" ToolTip="a routine file appended to this tab"/>
                            <Button Style="{StaticResource Big}" Content="Load in selected" local:Look.Glyph="📂" local:Look.Tint="{StaticResource Blue}" Click="LoadRoutineSelected_Click" ToolTip="a routine file appended to every checked golem's tab"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="scripts" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Clear tab" local:Look.Glyph="✕" local:Look.Tint="{StaticResource Red}" Click="ClearTab_Click" ToolTip="this golem's script, emptied"/>
                            <Button Style="{StaticResource Big}" Content="Clear all tabs" local:Look.Glyph="✖" local:Look.Tint="{StaticResource Red}" Click="ClearAllTabs_Click" ToolTip="every golem's script, emptied — the queues that are sending are not touched"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="choreography by the console" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Formation" local:Look.Glyph="⬟" local:Look.Tint="{StaticResource Purple}" Click="Formation_Click" ToolTip="square, pentagon, triangle or circle: the console writes every golem's script — the places, the steps around"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="View">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="golems" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Refresh" local:Look.Glyph="⟳" local:Look.Tint="{StaticResource Blue}" Click="Refresh_Click" ToolTip="ping every golem and ask where it stands"/>
                            <Button Style="{StaticResource Big}" Content="Journal" local:Look.Glyph="📖" Click="Journal_Click" ToolTip="follow the current golem's journal, live"/>
                            <Button Style="{StaticResource Big}" Content="Commands" local:Look.Glyph="?" Click="Commands_Click" ToolTip="the language the golem speaks"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="panels" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource Big}" Content="Debugger" local:Look.Glyph="◧" local:Look.Tint="{StaticResource Purple}" Click="ToggleDebugger_Click" ToolTip="show or hide the golem debugger at the right (F9)"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>


        <!-- THE CONSOLE'S TWO COLUMNS: the golems (fixed), the script (grows); the golem debugger is the window's own right column (so the map fits the
             resolution — Juan, 6-oct-2026: "el mapa como que no se ajusta muy bien a la resolución actual") -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- THE BOTTOM: the log and the journal of the current golem, under the golems and the script only — the debugger keeps the
                 whole height of its column, so the map is not squeezed by the foot under it (7-oct-2026) -->
            <TabControl Grid.Row="1" Grid.ColumnSpan="2" Height="180" Margin="4" Style="{StaticResource DarkTabs}">
                <TabItem Header="log — what every golem answered">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </TabItem>
                <TabItem x:Name="JournalTab" Header="journal">
                    <TextBox x:Name="JournalBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </TabItem>
            </TabControl>

            <!-- THE GOLEMS: boxes in their colour — the one clicked is the tab whose script the centre shows; a check addresses them together -->
            <GroupBox Grid.Column="0" Header="golems in operation — click one for its script">
                <DockPanel>
                    <!-- adding and removing golems: a dialog, not fields always in sight (Juan, 7-oct-2026: "¿no debería salir como parte de un modal,
                         un botón que permita agregar nuevos golems al CLI, en vez de verlo de primera entrada?") -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Content="+ add golem…" Click="AddGolem_Click" ToolTip="a golem in operation, by its host and port — or the four of the compose"/>
                        <Button Content="remove" Click="RemoveGolem_Click" ToolTip="the selected golem leaves this workspace, its script with it (asks first); the golem itself is untouched"/>
                    </UniformGrid>
                    <!-- THE GOLEM'S ENVIRONMENT (Juan, 7-oct-2026: "eso quizás debería estar en la configuración del golem… parece más de ambiente del
                         golem, no tanto de operaciones de los scripts"): the selected golem's scenario, its way of taking the doors, and its levers —
                         acted AT ONCE on that golem, never a line of its script; reset all asks first -->
                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,4">
                        <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="2,0,0,4" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}"/><Run Text="'s environment — acted at once"/></TextBlock>
                                        <DockPanel>
                                            <TextBlock Text="scenario" Width="62" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Tag="{Binding ScenarioPrompt, Mode=OneWay}" ItemsSource="{Binding ScenarioOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Scenario_Selected" ToolTip="the scenarios this golem knows, as it lists them — pick one and it enters it now"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="navigation" Width="62" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Tag="{Binding NavigationPrompt, Mode=OneWay}" ItemsSource="{Binding NavigationOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Navigation_Selected" ToolTip="how its routes take the doors — door by door, or the doors crossed on the way; pick one and it switches now"/>
                                        </DockPanel>
                                        <UniformGrid Columns="3" Margin="0,2,0,0">
                                            <Button Content="place" Tag="{Binding}" Click="PlaceNow_Click" ToolTip="the body carried onto the debugger's point (x, y) — now"/>
                                            <Button Content="reset" Tag="{Binding}" Click="ResetNow_Click" ToolTip="every route let go, the body back on its mark — now"/>
                                            <Button Content="reset all" Tag="{Binding}" Click="ResetAllNow_Click" Foreground="{StaticResource Red}" ToolTip="reset --all: its journal wiped too — asks first"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                    <ListBox x:Name="GolemList" ItemTemplate="{StaticResource GolemBox}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GolemList_SelectionChanged"/>
                </DockPanel>
            </GroupBox>

            <!-- THE CENTRE: the script of the golem clicked on the left; the script is its queue -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <ContentControl x:Name="Editor" Content="{Binding SelectedItem, ElementName=GolemList}" ContentTemplate="{StaticResource ScriptOf}"/>
                        <TextBlock x:Name="NoGolem" Text="add a golem on the left, click its box: its script is built here" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" x:Name="WorkspaceLabel" Margin="6,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Text="no workspace: the scripts live in this window until you save one"/>
            </Grid>

        </Grid>
    </DockPanel>

        <!-- THE GOLEM DEBUGGER TAKES THE WHOLE RIGHT SIDE, from the top of the window beside the ribbon, and hides on demand (Juan, 7-oct-2026:
             "que ese panel use todo el lateral derecho para aprovechar ese espacio y que se pueda ocultar y mostrar"). It was ONE PANEL (Juan, 7-oct-2026: "toda esa zona sea un solo panel, la del mapa, porque básicamente es la
             lectura del golem; esa sección debería llamarse algo como debugger del golem porque hace lecturas junto con el mapa y permite crear los visit"):
             what the selected golem knows (where, state, route, obstacles, asked every 3 s), its map with everybody and its obstacles, and the tool
             that builds a command from a point — the map's clicks accumulate the visit's points -->
        <GroupBox x:Name="DebuggerPanel" Grid.Column="1">
            <DockPanel x:Name="DebuggerBody">
                <!-- its title, and the lever that hides it -->
                <DockPanel x:Name="DebuggerTitle" DockPanel.Dock="Top" Margin="2,0,0,4">
                    <Button DockPanel.Dock="Right" Content="hide ▸" Click="HideDebugger_Click" ToolTip="hide the debugger: the script and the log take the width — F9, View › Debugger or the strip at the right edge bring it back"/>
                    <!-- the title: what this panel is, and whose — the golem's name in its own colour (Juan, 7-oct-2026: "el título mejóralo") -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GOLEM DEBUGGER" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}" VerticalAlignment="Center">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" BorderBrush="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}" Background="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Fill}}">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}"/>
                                    </Border>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <TextBlock Text="what it knows, asked every 3 s" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <!-- the reads, as information -->
                <Border x:Name="ReadsBox" DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                    <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <!-- THE CARD: what the golem knows, a field each (Juan, 7-oct-2026: "se ve muy simple") — where it stands, where it is, its
                                     routes, the last one with its status in colour and why it ended short, its plan, and what it touched -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="62"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="position" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PositionText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ink}" Margin="0,2,12,2"/>
                                        <TextBlock Text="{Binding HeadingText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Text="in" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel Grid.Row="1" Grid.Column="1">
                                        <Border Style="{StaticResource Chip}" ToolTip="the zone it stands in"><TextBlock Text="{Binding Knowledge.Zone, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border Style="{StaticResource Chip}" ToolTip="the scenario it is in"><TextBlock Text="{Binding Knowledge.Scenario, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border Style="{StaticResource Chip}" ToolTip="how its routes take the doors"><TextBlock Text="{Binding Knowledge.Navigation, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border x:Name="HeldChip" Style="{StaticResource Chip}" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" ToolTip="the operator holds it: paused"><TextBlock Text="HELD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/></Border>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="2" Text="routes" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoutesText, Mode=OneWay}" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Text="last route" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel Grid.Row="3" Grid.Column="1">
                                        <TextBlock Text="{Binding RouteTitle, Mode=OneWay}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                        <Border x:Name="StatusChip" Style="{StaticResource Chip}">
                                            <TextBlock x:Name="StatusText" Text="{Binding Knowledge.RouteStatus, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding RouteNow, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="WhyLabel" Grid.Row="4" Text="why" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="WhyText" Grid.Row="4" Grid.Column="1" Text="{Binding Knowledge.RouteWhy, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,2"/>
                                    <TextBlock x:Name="PlanLabel" Grid.Row="5" Text="plan" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="PlanText" Grid.Row="5" Grid.Column="1" Text="{Binding Knowledge.RoutePlan, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2"/>
                                    <TextBlock Grid.Row="6" Text="touched" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ObstaclesText, Mode=OneWay}" FontSize="11" Margin="0,2"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="completed">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Green}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Green}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="failed">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Red}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Red}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="pending">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="">
                                        <Setter TargetName="StatusChip" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.Held}" Value="True">
                                        <Setter TargetName="HeldChip" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteWhy}" Value="">
                                        <Setter TargetName="WhyLabel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="WhyText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RoutePlan}" Value="">
                                        <Setter TargetName="PlanLabel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="PlanText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
                <!-- the map, as high as it is wide — the floor is square — so the foot sits right under it (Juan, 7-oct-2026: "está muy abajo esta lista");
                     a short window takes height from the map, never from the foot's least (FitDebugger) -->
                <!-- the map's title: its scenario in a chip, what is drawn on it, and whether the other golems are shown too — the selected one always is
                     (Juan, 7-oct-2026: "agrégale un checkbox para mostrar la posición de los otros golems, pero la del golem seleccionado siempre mostrarla") -->
                <DockPanel DockPanel.Dock="Top" x:Name="MapHeader" Margin="2,0,2,3">
                    <CheckBox x:Name="OthersBox" DockPanel.Dock="Right" Content="other golems" IsChecked="True" FontSize="11" VerticalAlignment="Center" Checked="Others_Changed" Unchecked="Others_Changed" ToolTip="draw the other golems where they were last seen — the selected one is always drawn"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MAP" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Style="{StaticResource Chip}" ToolTip="the scenario the selected golem is in, as it tells it"><TextBlock x:Name="MapScenario" Text="no scenario yet" FontSize="11"/></Border>
                        <TextBlock x:Name="MapNote" Text="" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <Grid x:Name="MapArea" DockPanel.Dock="Top">
                    <Canvas x:Name="Map" Background="{StaticResource Well}" MouseLeftButtonDown="Map_Click" MouseLeftButtonUp="Map_MouseUp" MouseMove="Map_MouseMove" MouseLeave="Map_MouseLeave" SizeChanged="Map_SizeChanged" ClipToBounds="True"/>
                    <!-- the coordinates under the cursor, while it is over the floor -->
                    <Border x:Name="Hover" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Background="#cc0f1419" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <TextBlock x:Name="HoverText" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="13"/>
                    </Border>
                </Grid>
                <!-- THE DEBUGGER'S FOOT, under the map (Juan, 7-oct-2026: "agrega mejor este tab como parte baja del mapa, ahí veremos las formaciones"):
                     two tabs of one height, so switching never moves the map; right under the map, the height left is theirs — the tool that builds a command from a point, and the active formations -->
                <TabControl x:Name="DebuggerFoot" MinHeight="176" Margin="0,4,0,0" Style="{StaticResource DarkTabs}">
                    <TabItem Header="point → command">
                        <!-- the tool: a point and a verb build one command; the points clicked on the map accumulate for visit and cover -->
                        <Border Background="{StaticResource Well}" Padding="6,4">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="x" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox DockPanel.Dock="Left" x:Name="XBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                    <TextBlock DockPanel.Dock="Left" Text="y" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBox DockPanel.Dock="Left" x:Name="YBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                    <TextBox x:Name="BuiltBox" FontFamily="Consolas" FontSize="14" IsReadOnly="True" Text="visit 5.5,5.5" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Left" x:Name="Verbs" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="the verb of the command built">
                                        <RadioButton Content="visit" IsChecked="True" Checked="Point_Changed" Margin="0,0,6,0"/>
                                        <RadioButton Content="cover" Checked="Point_Changed" Margin="0,0,6,0"/>
                                        <RadioButton Content="then" Checked="Point_Changed" Margin="0,0,6,0"/>
                                        <RadioButton Content="place" Checked="Point_Changed" Margin="0,0,6,0"/>
                                        <RadioButton Content="forget" Checked="Point_Changed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PointsHint" Text="click the map: every click adds a point to the visit, in order" Foreground="{StaticResource Dim}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="add to this tab" Click="AddBuilt_Click"/>
                                    <Button Content="add to selected" Click="AddBuiltSelected_Click" ToolTip="the same command on every checked golem's tab"/>
                                    <Button Content="copy" Click="CopyBuilt_Click" ToolTip="the command to the clipboard, to paste in another tab"/>
                                    <Button Content="undo" Click="UndoPoint_Click" Margin="10,0,0,0" ToolTip="the last point clicked, taken back"/>
                                    <Button Content="clear" Click="ClearPoints_Click" ToolTip="forget every point clicked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <!-- THE ACTIVE FORMATIONS (propuesta 96): every formation laid out, who holds which vertex, its eye — the figure PROJECTED on the
                         map (Juan, 7-oct-2026: "que se vea la forma de la figura encima del mapa para proyectar la formación seleccionada… un botón
                         como un ojo") — and the rotations the operator asks of it, each a visit on every member's tab; the one selected is drawn strongest -->
                    <TabItem x:Name="FormationsTab" Header="formations">
                        <DockPanel Background="{StaticResource Well}">
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                                <TextBlock x:Name="NoFormation" Text="none yet — Console › Formation lays one out here" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="FormationList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,2">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource EyeToggle}" IsChecked="{Binding Shown}" ToolTip="show or hide this figure on the map"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="ShotButton" Content="shot" Tag="{Binding}" Click="Shot_Click" Margin="2,2,8,2" ToolTip="write the formation as it stands on the tabs: every golem's visit to its vertex"/>
                                                <Button Content="↻" Tag="{Binding}" Click="RotateClockwise_Click" ToolTip="everybody one step clockwise (down the figure's order): a visit on every member's tab"/>
                                                <Button Content="↺" Tag="{Binding}" Click="RotateCounter_Click" ToolTip="everybody one step counter-clockwise: a visit on every member's tab"/>
                                                <Button Content="✕" Tag="{Binding}" Click="Dissolve_Click" ToolTip="dissolve: the formation leaves the list; the golems stay where they are"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  at "/><Run Text="{Binding Figure.Center, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run Text="  turned "/><Run Text="{Binding Turned, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run x:Name="Draft" Text="" Foreground="{StaticResource Accent}" FontWeight="Normal" FontSize="11"/></TextBlock>
                                                <TextBlock Text="{Binding Holders, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- changed on the map and not on the tabs yet: the shot lit, the line says so (Juan, 7-oct-2026: "un botón para agregar a los tabs… como un shot formation") -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Unshot}" Value="True">
                                                <Setter TargetName="ShotButton" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="ShotButton" Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="ShotButton" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="Draft" Property="Text" Value="  · draft"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </GroupBox>
        <!-- the strip the debugger leaves when hidden: one click brings it back -->
        <Border x:Name="DebuggerStrip" Grid.Column="1" Visibility="Collapsed" Width="30" Margin="0,4,4,4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="ShowDebugger_Click" ToolTip="show the golem debugger (F9)">
            <TextBlock Text="◂  golem debugger" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>
    </Grid>
</Window>
