<Window x:Class="WardenCli.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WardenCli.Views"
        Title="WardenCli — the operator's console" Icon="/warden.ico" Height="860" Width="1400" MinHeight="640" MinWidth="1060"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- a golem in the list: a box in its colour, like the sketch -->
        <DataTemplate x:Key="GolemBox">
            <Border x:Name="Box" BorderThickness="3" CornerRadius="3" Margin="4,3" Padding="6,4" Background="{StaticResource Well}" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}" Opacity="0.7"
                    ToolTip="click: this golem's script in the centre · check: addressed by 'selected'">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="selected: send and paste go to the selected golems"/>
                    <TextBlock x:Name="Marker" DockPanel.Dock="Right" Text="▶ script" Visibility="Collapsed" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource Ink}"><Run Text="{Binding Name}"/><Run Text="  "/><Run x:Name="Addr" Text="{Binding Address, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11" FontWeight="Normal"/></TextBlock>
                        <TextBlock Text="{Binding StatusLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="Seen" Text="{Binding LastSeen, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- the box whose script is in the centre: tinted in its golem's colour, its border a little thicker, a "script" tag in the accent;
                 the others dimmed (Juan, 7-oct-2026: "destacar el golem seleccionado… no se nota aún" — then, on a white border and a glow: "muy exagerado") -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="1"/>
                    <Setter TargetName="Box" Property="Background" Value="{Binding Name, Converter={x:Static local:GolemColor.Fill}}"/>
                    <Setter TargetName="Box" Property="BorderThickness" Value="4"/>
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Addr" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Seen" Property="Foreground" Value="{StaticResource Ink}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ScriptOf">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"><Run Text="the script for "/><Run Text="{Binding Name}" FontWeight="Bold" Foreground="#e6e1cf"/><Run Text=" — one command per line, sent in order; a line starting with # is a note"/></TextBlock>
                <!-- THE SEND COLUMN (Juan, 7-oct-2026: "sólo enviar a los selected… el stop debajo y posiciónalos hasta abajo"): one SEND, to the
                     checked golems, at the foot of the column with stop under it; which golems go is said by the checks, never by a button -->
                <DockPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Margin="4,4" Foreground="{StaticResource Dim}" TextWrapping="Wrap"><Run Text="sent "/><Run Text="{Binding Sent}"/><Run Text=" command(s) this session"/></TextBlock>
                    <Button DockPanel.Dock="Bottom" Content="SEND to selected" Click="SendSelected_Click" Height="56" FontSize="15" FontWeight="Bold" Style="{StaticResource GoGreen}" ToolTip="the queue of every checked golem, each its own, line by line; they wait for each other at @sync"/>
                    <Button DockPanel.Dock="Bottom" Content="stop" Margin="2,2,2,4" Click="StopSelected_Click" ToolTip="the checked golems that are sending stop; the rest of each queue stays on its tab"/>
                </DockPanel>
                <!-- ABOVE THE SCRIPT: what the golem can be told (Juan, 6-oct-2026: "algunos botones siempre por arriba y al centro el comando") -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,0,4">
                    <WrapPanel>
                        <TextBlock Text="errands" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <Button Content="visit" Tag="visit {point}" Click="Compose_Click" ToolTip="visit x,y — go there, through every point picked on the map"/>
                        <Button Content="cover" Tag="cover {point}" Click="Compose_Click" ToolTip="cover x,y — the way decided at once"/>
                        <TextBlock Text="hold" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Button Content="pause" Tag="pause" Click="Compose_Click"/>
                        <Button Content="resume" Tag="resume" Click="Compose_Click"/>
                        <!-- WAIT (Juan, 8-oct-2026: "el wait déjalo en la parte superior de los comandos"): a @sync on this tab — the console's barrier,
                             never sent: this golem waits there until every golem sent with it reached its own @sync, or finished -->
                        <TextBlock Text="together" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Button Content="wait" Tag="@sync" Click="Compose_Click" ToolTip="@sync — this golem waits here until every golem sent with it reaches its own @sync (or has nothing left); never sent to the golem"/>
                    </WrapPanel>
                </Border>
                <Border BorderThickness="3,0,0,0" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}">
                    <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Margin="0"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" SelectionChanged="Script_SelectionChanged"/>
                </Border>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConsoleColumn" Width="2*" MinWidth="642"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="DebuggerColumn" Width="*" MinWidth="330"/>
        </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
        <!-- THE RIBBON: our own, dark — tabs of groups of big buttons; every button composes a command on the current golem's tab -->
        <TabControl DockPanel.Dock="Top" x:Name="Ribbon" Style="{StaticResource RibbonTabs}" Height="152">
            <TabItem Header="Workspace">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="workspace" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="New" local:Look.Glyph="✧" Click="NewWorkspace_Click" ToolTip="a clean window: no golems, no scripts"/>
                            <Button Style="{StaticResource Big}" Content="Open…" local:Look.Glyph="📂" Click="OpenWorkspace_Click" ToolTip="a workspace file: the golems and their scripts"/>
                            <Button Style="{StaticResource Big}" Content="Save" local:Look.Glyph="💾" Click="SaveWorkspace_Click"/>
                            <!-- A SHOW (13-oct-2026; Juan: "cuando vuelvo a cargar el mismo workspace ya no tiene nada… ¿el ambiente reescribe el archivo?"): the queues
                                 consume the lines as they go and the workspace autosaves them as they are, so a workspace used as a show was emptied by its own run.
                                 A show is the same file, loaded INTO the tabs of the golems here and saved FROM them, never becoming the workspace: load it again, run it again -->
                            <Button Style="{StaticResource Big}" Content="Load show…" local:Look.Glyph="🎭" Click="LoadShow_Click" ToolTip="a .golemws of scripts loaded into the tabs of the golems here, by name — the workspace stays this one; load it again to run it again"/>
                            <Button Style="{StaticResource Big}" Content="Save show…" local:Look.Glyph="🎭" local:Look.Tint="{StaticResource Accent}" Click="SaveShow_Click" ToolTip="every tab's script into a .golemws of its own, to load as a show — the workspace stays this one"/>
                            <Button Style="{StaticResource Big}" Content="Save as…" local:Look.Glyph="💾" local:Look.Tint="{StaticResource Accent}" Click="SaveWorkspaceAs_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="recent workspaces — click to switch" Style="{StaticResource RibbonGroup}">
                        <WrapPanel x:Name="RecentPanel" Orientation="Vertical" MaxHeight="96" VerticalAlignment="Top">
                            <TextBlock Text="none yet" Foreground="{StaticResource Dim}" Margin="4"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="program" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="About" local:Look.Glyph="ⓘ" Click="About_Click"/>
                            <Button Style="{StaticResource Big}" Content="Exit" local:Look.Glyph="⏻" local:Look.Tint="{StaticResource Red}" Click="Exit_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Console" IsSelected="True">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="clipboard" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Paste" local:Look.Glyph="📋" Click="Paste_Click" ToolTip="appends the clipboard's lines to this tab's script"/>
                            <Button Style="{StaticResource Big}" Content="Copy script" local:Look.Glyph="⎘" Click="Copy_Click" ToolTip="this tab's script to the clipboard"/>
                            <Button Style="{StaticResource Big}" Content="Copy line" local:Look.Glyph="⎘" Click="CopyLine_Click" ToolTip="the line under the cursor of this tab's script to the clipboard (16-oct-2026)"/>
                            <Button Style="{StaticResource Big}" Content="To selected" local:Look.Glyph="⇶" local:Look.Tint="{StaticResource Blue}" Click="CopyToSelected_Click" ToolTip="appends this tab's script to every checked golem's tab"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="scripts" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Clear tab" local:Look.Glyph="✕" local:Look.Tint="{StaticResource Red}" Click="ClearTab_Click" ToolTip="this golem's script, emptied"/>
                            <Button Style="{StaticResource Big}" Content="Clear all tabs" local:Look.Glyph="✖" local:Look.Tint="{StaticResource Red}" Click="ClearAllTabs_Click" ToolTip="every golem's script, emptied — the queues that are sending are not touched"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="choreography by the console" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Formation" local:Look.Glyph="⬟" local:Look.Tint="{StaticResource Purple}" Click="Formation_Click" ToolTip="square, pentagon, triangle or circle: the console writes every golem's script — the places, the steps around"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="play" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Pacman" local:Look.Glyph="ᗧ" local:Look.Tint="{StaticResource Accent}" Click="Play_Click" ToolTip="who plays pacman and who the ghosts: the console writes the board and the play on every member's tab (propuesta 108); then release pacman from the play tab and steer it with the arrows"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="View">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="golems" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Refresh" local:Look.Glyph="⟳" local:Look.Tint="{StaticResource Blue}" Click="Refresh_Click" ToolTip="ping every golem and ask where it stands"/>
                            <Button Style="{StaticResource Big}" Content="Journal" local:Look.Glyph="📖" Click="Journal_Click" ToolTip="follow the current golem's journal, live"/>
                            <Button Style="{StaticResource Big}" Content="Commands" local:Look.Glyph="?" Click="Commands_Click" ToolTip="the language the golem speaks"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="panels" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource Big}" Content="Debugger" local:Look.Glyph="◧" local:Look.Tint="{StaticResource Purple}" Click="ToggleDebugger_Click" ToolTip="show or hide the golem debugger at the right (F9)"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>


        <!-- THE CONSOLE'S TWO COLUMNS: the golems (fixed), the script (grows); the golem debugger is the window's own right column (so the map fits the
             resolution — Juan, 6-oct-2026: "el mapa como que no se ajusta muy bien a la resolución actual") -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GolemsColumn" Width="262" MinWidth="190"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LogRow" Height="180" MinHeight="70"/>
            </Grid.RowDefinitions>
            <!-- the dividers: between the golems and the script, and between them and the log -->
            <GridSplitter Grid.Column="1" Style="{StaticResource DividerV}" ToolTip="drag to share the width between the golems and the script"/>
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource DividerH}" ToolTip="drag to give the log more or less height"/>

            <!-- THE BOTTOM: the log and the journal of the current golem, under the golems and the script only — the debugger keeps the
                 whole height of its column, so the map is not squeezed by the foot under it (7-oct-2026) -->
            <TabControl Grid.Row="2" Grid.ColumnSpan="3" Margin="4" Style="{StaticResource DarkTabs}">
                <TabItem Header="log — what every golem answered">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </TabItem>
                <TabItem x:Name="JournalTab" Header="journal">
                    <!-- the scripts with their line breaks, and a box per kind of entry to hide it (13-oct-2026; Juan: "que se vean bien los scripts del
                         journal con sus saltos de línea… y permitir esconder de cierto tipo") -->
                    <DockPanel>
                        <WrapPanel x:Name="JournalKinds" DockPanel.Dock="Top" Margin="6,3,6,2" VerticalAlignment="Center">
                            <TextBlock Text="show:" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </WrapPanel>
                        <TextBox x:Name="JournalBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" AcceptsReturn="True"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- THE GOLEMS: boxes in their colour — the one clicked is the tab whose script the centre shows; a check addresses them together -->
            <GroupBox Grid.Column="0" Header="golems in operation — click one for its script">
                <DockPanel>
                    <!-- adding and removing golems: a dialog, not fields always in sight (Juan, 7-oct-2026: "¿no debería salir como parte de un modal,
                         un botón que permita agregar nuevos golems al CLI, en vez de verlo de primera entrada?") -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Content="+ add golem…" Click="AddGolem_Click" ToolTip="a golem in operation, by its host and port — or the four of the compose"/>
                        <Button Content="remove" Click="RemoveGolem_Click" ToolTip="the selected golem leaves this workspace, its script with it (asks first); the golem itself is untouched"/>
                    </UniformGrid>
                    <!-- THE GOLEM'S ENVIRONMENT (Juan, 7-oct-2026: "eso quizás debería estar en la configuración del golem… parece más de ambiente del
                         golem, no tanto de operaciones de los scripts"): the selected golem's scenario, its way of taking the doors, and its levers —
                         acted AT ONCE on that golem, never a line of its script; reset all asks first -->
                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,4">
                        <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="2,0,0,4" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}"/><Run Text="'s environment — acted at once"/></TextBlock>
                                        <DockPanel>
                                            <TextBlock Text="scenario" Width="62" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Tag="{Binding ScenarioPrompt, Mode=OneWay}" ItemsSource="{Binding ScenarioOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Scenario_Selected" ToolTip="the scenarios this golem knows, as it lists them — pick one and it enters it now"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="navigation" Width="62" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Tag="{Binding NavigationPrompt, Mode=OneWay}" ItemsSource="{Binding NavigationOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Navigation_Selected" ToolTip="how its routes take the doors — door by door, or the doors crossed on the way; pick one and it switches now"/>
                                        </DockPanel>
                                        <!-- the body's pace (propuesta 111, 12-oct-2026; Juan: "en el panel del environment para subirle la velocidad"): presets of cruise and turn rate, told at once (`speed … turn …`) -->
                                        <DockPanel>
                                            <TextBlock Text="speed" Width="62" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox Tag="{Binding PacePrompt, Mode=OneWay}" ItemsSource="{Binding PaceOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Pace_Selected" ToolTip="the body's cruise (m/s) and turn rate (rad/s) from here on — speed … --turn …, acted at once; the motors cap what it can really do"/>
                                        </DockPanel>
                                        <!-- no place here (Juan, 8-oct-2026: "quita el place del ambiente del golem"): it is the map's ⌖ place button -->
                                        <!-- the same environment for the whole fleet (Juan, 9-oct-2026: "algún botón para aplicar esa configuración a todos los golems"):
                                             this golem's scenario and navigation, told now to every other golem of the workspace that differs -->
                                        <Button Content="apply to all golems" Tag="{Binding}" Click="ApplyEnvironmentToAll_Click" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                                ToolTip="use map …, optimize … and speed … as this golem has them, sent now to every other golem of the workspace that differs"/>
                                        <Button Content="anchor" Tag="{Binding}" Click="AnchorNow_Click" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                                ToolTip="the golem takes where its body REALLY stands as where it stands — nothing moves, no reset; for when the map's position drifted from Gazebo's (13-oct-2026)"/>
                                        <UniformGrid Columns="2" Margin="0,2,0,0">
                                            <Button Content="reset" Tag="{Binding}" Click="ResetNow_Click" ToolTip="every route let go, the body back on its mark — now"/>
                                            <Button Content="reset all" Tag="{Binding}" Click="ResetAllNow_Click" Foreground="{StaticResource Red}" ToolTip="reset --all: its journal wiped too — asks first"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                    <ListBox x:Name="GolemList" ItemTemplate="{StaticResource GolemBox}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GolemList_SelectionChanged"/>
                </DockPanel>
            </GroupBox>

            <!-- THE CENTRE: the script of the golem clicked on the left; the script is its queue -->
            <Grid Grid.Column="2" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <ContentControl x:Name="Editor" Content="{Binding SelectedItem, ElementName=GolemList}" ContentTemplate="{StaticResource ScriptOf}"/>
                        <TextBlock x:Name="NoGolem" Text="add a golem on the left, click its box: its script is built here" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" x:Name="WorkspaceLabel" Margin="6,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Text="no workspace: the scripts live in this window until you save one"/>
            </Grid>

        </Grid>
    </DockPanel>

        <!-- the divider between the console and the debugger -->
        <GridSplitter x:Name="ShellDivider" Grid.Column="1" Style="{StaticResource DividerV}" ToolTip="drag to share the width between the console and the debugger"/>
        <!-- THE GOLEM DEBUGGER TAKES THE WHOLE RIGHT SIDE, from the top of the window beside the ribbon, and hides on demand (Juan, 7-oct-2026:
             "que ese panel use todo el lateral derecho para aprovechar ese espacio y que se pueda ocultar y mostrar"). It was ONE PANEL (Juan, 7-oct-2026: "toda esa zona sea un solo panel, la del mapa, porque básicamente es la
             lectura del golem; esa sección debería llamarse algo como debugger del golem porque hace lecturas junto con el mapa y permite crear los visit"):
             what the selected golem knows (where, state, route, obstacles, asked every 3 s), its map with everybody and its obstacles, and the tool
             that builds a command from a point — the map's clicks accumulate the visit's points -->
        <GroupBox x:Name="DebuggerPanel" Grid.Column="2">
            <DockPanel x:Name="DebuggerBody">
                <!-- its title, and the lever that hides it -->
                <DockPanel x:Name="DebuggerTitle" DockPanel.Dock="Top" Margin="2,0,0,4">
                    <Button DockPanel.Dock="Right" Content="hide ▸" Click="HideDebugger_Click" ToolTip="hide the debugger: the script and the log take the width — F9, View › Debugger or the strip at the right edge bring it back"/>
                    <!-- the title: what this panel is, and whose — the golem's name in its own colour (Juan, 7-oct-2026: "el título mejóralo") -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GOLEM DEBUGGER" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}" VerticalAlignment="Center">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" BorderBrush="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}" Background="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Fill}}">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{Binding Name, Mode=OneWay, Converter={x:Static local:GolemColor.Brush}}"/>
                                    </Border>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <TextBlock Text="what it knows" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <!-- the reads on demand (Juan, 9-oct-2026: "no lo hagas cada 3 segundos; agrega un botón para refrescar y otro para hacerlo cada 3 segundos"):
                             refresh asks where, state, route, obstacles and formations once; auto asks them every 3 s while it is on -->
                        <Button Content="refresh" Click="RefreshReads_Click" Margin="8,0,0,0" Padding="6,1" FontSize="11" ToolTip="ask the selected golem its reads now: where, state, route, obstacles, formations"/>
                        <CheckBox x:Name="AutoBox" Content="auto" Checked="Auto_Toggled" Unchecked="Auto_Toggled" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" ToolTip="ask them again every 3 s while on"/>
                    </StackPanel>
                </DockPanel>
                <!-- the reads, as information -->
                <Border x:Name="ReadsBox" DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                    <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <!-- THE CARD: what the golem knows, a field each (Juan, 7-oct-2026: "se ve muy simple") — where it stands, where it is, its
                                     routes, the last one with its status in colour and why it ended short, its plan, and what it touched -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="62"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="position" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                                        <TextBlock Text="{Binding PositionText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ink}" Margin="0,2,12,2"/>
                                        <TextBlock Text="{Binding HeadingText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="in" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" ClipToBounds="True">
                                        <Border Style="{StaticResource Chip}" ToolTip="the zone it stands in"><TextBlock Text="{Binding Knowledge.Zone, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border Style="{StaticResource Chip}" ToolTip="the scenario it is in"><TextBlock Text="{Binding Knowledge.Scenario, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border Style="{StaticResource Chip}" ToolTip="how its routes take the doors"><TextBlock Text="{Binding Knowledge.Navigation, Mode=OneWay}" FontSize="11"/></Border>
                                        <Border x:Name="HeldChip" Style="{StaticResource Chip}" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" ToolTip="the operator holds it: paused"><TextBlock Text="HELD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/></Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="routes" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoutesText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Text="last route" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" ClipToBounds="True">
                                        <TextBlock Text="{Binding RouteTitle, Mode=OneWay}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                        <Border x:Name="StatusChip" Style="{StaticResource Chip}">
                                            <TextBlock x:Name="StatusText" Text="{Binding Knowledge.RouteStatus, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding RouteNow, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WhyLabel" Grid.Row="4" Text="why" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="WhyText" Grid.Row="4" Grid.Column="1" Text="{Binding WhyText, Mode=OneWay}" ToolTip="{Binding WhyText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Red}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                    <TextBlock x:Name="PlanLabel" Grid.Row="5" Text="plan" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="PlanText" Grid.Row="5" Grid.Column="1" Text="{Binding PlanText, Mode=OneWay}" ToolTip="{Binding PlanText, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                    <TextBlock Grid.Row="6" Text="touched" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ObstaclesText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="completed">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Green}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Green}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="failed">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Red}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Red}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="pending">
                                        <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteStatus}" Value="">
                                        <Setter TargetName="StatusChip" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.Held}" Value="True">
                                        <Setter TargetName="HeldChip" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Knowledge.RouteWhy}" Value="">
                                        <Setter TargetName="WhyText" Property="Foreground" Value="{StaticResource Dim}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
                <!-- the map, as high as it is wide — the floor is square — so the foot sits right under it (Juan, 7-oct-2026: "está muy abajo esta lista");
                     a short window takes height from the map, never from the foot's least (FitDebugger) -->
                <!-- the map's title: its scenario in a chip, what is drawn on it, and whether the other golems are shown too — the selected one always is
                     (Juan, 7-oct-2026: "agrégale un checkbox para mostrar la posición de los otros golems, pero la del golem seleccionado siempre mostrarla") -->
                <DockPanel DockPanel.Dock="Top" x:Name="MapHeader" Margin="2,0,2,3">
                    <!-- PLACE ON THE MAP (Juan, 8-oct-2026: "esta otra opción de place puede ser como un botón arriba del mapa que cuando se dé clic espere
                         por la posición de donde desea ser ubicado en el mapa el golem actual; si da clic a otra cosa se cancela"): armed, the next click on the
                         floor carries the selected golem's body there at once; a click anywhere else, or Esc, disarms it -->
                    <!-- one row, nothing over anything (Juan, 8-oct-2026: "ajusta la distribución que se vea mejor"): the tools at the right with room
                         between them, the title and its chip at the left, the note filling what is left and cut with … (whole in its tooltip) -->
                    <Button x:Name="PlaceButton" DockPanel.Dock="Right" Content="⌖ place" FontSize="11" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Click="PlaceOnMap_Click"
                            ToolTip="click, then click the map: the selected golem's body is carried there at once (place x,y) — a click anywhere else, or Esc, cancels"/>
                    <CheckBox x:Name="OthersBox" DockPanel.Dock="Right" Content="other golems" IsChecked="True" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Others_Changed" Unchecked="Others_Changed" ToolTip="draw the other golems where they were last seen — the selected one is always drawn"/>
                    <CheckBox x:Name="ExploredBox" DockPanel.Dock="Right" Content="explored" IsChecked="True" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Checked="Explored_Changed" Unchecked="Explored_Changed" ToolTip="draw what the golem explored over the map — the cells it deduced free (teal) or wall (dark), the frontier of the unknown (rings) — while the exploration tab is open"/>
                    <TextBlock DockPanel.Dock="Left" Text="MAP" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" VerticalAlignment="Center" ToolTip="the scenario the selected golem is in, as it tells it"><TextBlock x:Name="MapScenario" Text="no scenario yet" FontSize="11"/></Border>
                    <TextBlock x:Name="MapNote" Text="" Foreground="{StaticResource Dim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
                <Grid x:Name="MapArea" DockPanel.Dock="Top">
                    <Canvas x:Name="Map" Background="{StaticResource Well}" MouseLeftButtonDown="Map_Click" MouseLeftButtonUp="Map_MouseUp" MouseMove="Map_MouseMove" MouseLeave="Map_MouseLeave" SizeChanged="Map_SizeChanged" ClipToBounds="True"/>
                    <!-- the coordinates under the cursor, while it is over the floor -->
                    <Border x:Name="Hover" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Background="#cc0f1419" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <TextBlock x:Name="HoverText" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="13"/>
                    </Border>
                </Grid>
                <!-- the divider between the map and its tabs: dragged, the map takes that height; double-click, as high as it is wide again -->
                <Thumb x:Name="MapDivider" DockPanel.Dock="Top" Style="{StaticResource DividerThumb}" DragDelta="MapDivider_DragDelta" MouseDoubleClick="MapDivider_DoubleClick" ToolTip="drag to give the map or its tabs more height — double-click: the map square again"/>
                <!-- THE DEBUGGER'S FOOT, under the map (Juan, 7-oct-2026: "agrega mejor este tab como parte baja del mapa, ahí veremos las formaciones"):
                     two tabs of one height, so switching never moves the map; right under the map, the height left is theirs — the tool that builds a command from a point, and the active formations -->
                <TabControl x:Name="DebuggerFoot" MinHeight="176" Margin="0" Style="{StaticResource DarkTabs}" SelectionChanged="DebuggerFoot_SelectionChanged">
                    <!-- THE GOLEM'S FORMATIONS (propuesta 104; Juan: "la pestaña de formaciones será una consulta GET del golem para ver a cuáles él está
                         metido"): what the selected golem's `formations` read says — its figure, who holds which place, how many stand on theirs — with
                         its eye (the figure PROJECTED on the map, propuesta 96), its steps (↻ ↺ write rotate on the tab) and its dissolution; FIRST of the foot's tabs, its count in the header (Juan, 9-oct-2026) -->
                    <TabItem x:Name="FormationsTab">
                        <TabItem.Header>
                            <TextBlock><Run Text="formations"/><Run x:Name="FormationsCount" Text=""/></TextBlock>
                        </TabItem.Header>
                        <DockPanel Background="{StaticResource Well}">
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                                <!-- the other golems' formations too (12-oct-2026; Juan: "me gustaría poder ver las de los otros también… agrégame el checkbox de other golems también ahí"):
                                     those the selected golem is not in, each row naming its golem; ↻ ↺ write on that golem's tab and ✕ asks that golem; read every refresh while on -->
                                <CheckBox x:Name="OthersFormationsBox" DockPanel.Dock="Right" Content="other golems" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OthersFormations_Changed" Unchecked="OthersFormations_Changed"
                                          ToolTip="list the other golems' formations too — the ones the selected golem is not in, each with its golem's name; they are read with every refresh while this is on. A formation told on the tabs and not sent is always listed, marked 'to send'"/>
                                <TextBlock x:Name="NoFormation" Text="select a golem: its formations are read from it" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="FormationList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,2">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource EyeToggle}" IsChecked="{Binding Shown}" Checked="Eye_Toggled" Unchecked="Eye_Toggled" ToolTip="show or hide this figure on the map"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- the draft (9-oct-2026): a figure moved, turned or resized on the map is told only when SHOT - form … again to the selected golem, which tells its fleet; the arrow drops it -->
                                                <StackPanel x:Name="DraftButtons" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Button Content="shot" Tag="{Binding}" Click="Shot_Click" Background="{StaticResource Accent}" Foreground="{StaticResource Panel}" FontWeight="Bold" ToolTip="write the adjustment on the selected golem's tab: form … again with the figure drafted on the map, and take …; nothing goes until SEND — the golem then tells its fleet"/>
                                                    <Button Content="↶" Tag="{Binding}" Click="Discard_Click" ToolTip="drop the draft: the map shows the formation as the golem has it"/>
                                                </StackPanel>
                                                <StackPanel x:Name="WholeTurn" Orientation="Horizontal">
                                                    <Button Content="↻" Tag="{Binding}" Click="RotateClockwise_Click" ToolTip="write rotate … clockwise on the selected golem's tab; sent, every body takes one place down the figure's order once all stand on theirs — the golem tells its fleet, and who holds what is read back from it"/>
                                                    <Button Content="↺" Tag="{Binding}" Click="RotateCounter_Click" ToolTip="write rotate … counterclockwise on the selected golem's tab"/>
                                                </StackPanel>
                                                <Button Content="■" Tag="{Binding}" Click="Finish_Click" ToolTip="write finish … on every member's tab, after its take and steps (propuesta 117): each golem says its part is done — counted when its last step is walked — and when all did, the last of the fleet cues the golem the formation names (--cue)"/>
                                                <Button Content="✎" Tag="{Binding}" Click="Edit_Click" ToolTip="edit it: the figure, centre, size, policy and fleet told again under the same name — its form (and take) lines rewritten on the tabs, a golem added gets them, one dropped loses them; SEND when ready"/>
                                                <Button Content="✕" Tag="{Binding}" Click="Dissolve_Click" ToolTip="dissolve …, asked of the golem now: the formation leaves every golem of its fleet; the bodies stay where they are"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding OwnerText, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource Dim}"/><Run Text="  "/><Run Text="{Binding Shape, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run Text=" at "/><Run Text="{Binding CenterText, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run Text="{Binding RoundText, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run Text="{Binding DraftText, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="Normal" FontSize="11"/></TextBlock>
                                                <TextBlock Text="{Binding HoldersText, Mode=OneWay}" ToolTip="{Binding HoldersText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="StrandedRow" Text="{Binding StrandedText, Mode=OneWay}" ToolTip="{Binding StrandedText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Red}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDraft}" Value="True">
                                                <Setter TargetName="DraftButtons" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stranded}" Value="True">
                                                <Setter TargetName="StrandedRow" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="point → command">
                        <!-- the tool: a point and a verb build one command; the points clicked on the map accumulate for visit and cover -->
                        <Border Background="{StaticResource Well}" Padding="6,4">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="x" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox DockPanel.Dock="Left" x:Name="XBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                    <TextBlock DockPanel.Dock="Left" Text="y" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBox DockPanel.Dock="Left" x:Name="YBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                    <TextBox x:Name="BuiltBox" FontFamily="Consolas" FontSize="14" IsReadOnly="True" Text="visit 5.5,5.5" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Left" x:Name="Verbs" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="the verb of the command built">
                                        <RadioButton Content="visit" IsChecked="True" Checked="Point_Changed" Margin="0,0,6,0"/>
                                        <!-- no then (Juan, 8-oct-2026: "sí, quítalo de la consola"): a queued then came after its visit had ended and was refused;
                                             a visit through every point clicked is the errand of several stops -->
                                        <RadioButton Content="cover" Checked="Point_Changed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PointsHint" Text="click the map: every click adds a point to the visit, in order" Foreground="{StaticResource Dim}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="add to this tab" Click="AddBuilt_Click"/>
                                    <Button Content="add to selected" Click="AddBuiltSelected_Click" ToolTip="the same command on every checked golem's tab"/>
                                    <Button Content="copy" Click="CopyBuilt_Click" ToolTip="the command to the clipboard, to paste in another tab"/>
                                    <Button Content="undo" Click="UndoPoint_Click" Margin="10,0,0,0" ToolTip="the last point clicked, taken back"/>
                                    <Button Content="clear" Click="ClearPoints_Click" ToolTip="forget every point clicked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <!-- THE OBSTACLES (Juan, 8-oct-2026: "creo que haría falta poner algo de colisiones y poder removerlos si ya no están… como un tab, así
                         como antes manejábamos en el panel web"): what the selected golem learned by touching — a thing with its marks, a peer met — read
                         with the rest every 3 s; a row under the cursor is lit on the map; 'gone' says at once that it is no longer there: `forget x,y` at
                         its centre, the golem forgets it, marks and all, and tells its peers -->
                    <TabItem x:Name="ObstaclesTab">
                        <TabItem.Header>
                            <TextBlock><Run Text="obstacles"/><Run Text="{Binding SelectedItem.Knowledge.Obstacles.Count, ElementName=GolemList, Mode=OneWay, StringFormat=' ({0})'}"/></TextBlock>
                        </TabItem.Header>
                        <DockPanel Background="{StaticResource Well}">
                            <!-- every obstacle may go (Juan, 8-oct-2026: "permitir remover los obstáculos del golem"): a thing, or a peer met — history the golem
                                 keeps; 'forget all' forgets them one by one -->
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                                <Button DockPanel.Dock="Right" Content="forget all" Click="ForgetAll_Click" Margin="6,0,0,0"
                                        ToolTip="the golem forgets everything it learned by touching, one forget x,y at each centre — it asks first"/>
                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Text="what the selected golem learned by touching — 'gone' when it is no longer there: it forgets it and tells its peers"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="6,6" Foreground="{StaticResource Dim}" FontSize="12" Text="nothing touched yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.Knowledge.Obstacles.Count, ElementName=GolemList}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="ObstacleList" ItemsSource="{Binding SelectedItem.Knowledge.Obstacles, ElementName=GolemList}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,2" Background="Transparent" MouseEnter="ObstacleRow_MouseEnter" MouseLeave="ObstacleRow_MouseLeave">
                                            <Button DockPanel.Dock="Right" Content="gone" Tag="{Binding}" Click="ForgetObstacle_Click" VerticalAlignment="Center"
                                                    ToolTip="it is no longer there: the golem forgets it — a thing with all its marks, a peer met as history — and tells its peers; forget x,y at its centre, at once"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Red}"/><Run Text="  "/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Ink}" FontSize="11"/></TextBlock>
                                                <TextBlock Text="{Binding Marks, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <!-- THE DISPUTES (14-oct-2026; Juan: "otro apartado o tab abajo del mapa relacionado a las disputas que ha tenido el golem para resolver
                         una posición con otro golem y el resultado de si éste cedió o la ganó él, por la política de distance"): the selected golem's
                         `disputes` read — a place it wanted by distance, won or yielded, against whom, both distances -->
                    <TabItem x:Name="DisputesTab">
                        <TabItem.Header>
                            <TextBlock><Run Text="disputes"/><Run Text="{Binding SelectedItem.Knowledge.DisputeList.Count, ElementName=GolemList, Mode=OneWay, StringFormat=' ({0})'}"/></TextBlock>
                        </TabItem.Header>
                        <DockPanel Background="{StaticResource Well}">
                            <!-- CLEARED (14-oct-2026; Juan: "algún botón para limpiar las disputas"): forget disputes, on the selected golem or on every golem -->
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                                <Button DockPanel.Dock="Right" Content="clear all golems" Click="ClearAllDisputes_Click" Margin="6,0,0,0"
                                        ToolTip="every golem of the workspace forgets its disputes — forget disputes on each, at once"/>
                                <Button DockPanel.Dock="Right" Content="clear" Click="ClearDisputes_Click" Margin="6,0,0,0"
                                        ToolTip="the selected golem forgets its disputes — forget disputes, at once; the next ones come with the next rounds played"/>
                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="every golem wants the place nearest to where it stood; by distance the nearer one keeps it, by rps they play for it"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="6,6" Foreground="{StaticResource Dim}" FontSize="12" Text="no disputes yet — they come with the formations taken by distance">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.Knowledge.DisputeList.Count, ElementName=GolemList}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding SelectedItem.Knowledge.DisputeList, ElementName=GolemList}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Foreground" Value="{StaticResource Orange}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Won}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                                <Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource Ink}"/><Run Text="  "/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Distances, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <!-- THE PLAY (propuesta 108, fase 2): what the selected golem's `play` read says, the start and the end; pacman is AUTONOMOUS
                         (21-oct-2026; Juan: "pacman autónomo nada más") — no arrow keys, no head buttons, no driving modes -->
                    <TabItem x:Name="PlayTab" Header="play">
                        <DockPanel Background="{StaticResource Well}">
                            <TextBlock DockPanel.Dock="Top" Margin="6,4,6,0" FontSize="11" Foreground="{StaticResource Ink}" Text="{Binding SelectedItem.PlayText, ElementName=GolemList, Mode=OneWay}" TextWrapping="Wrap"/>
                            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,4" FontSize="11" Foreground="{StaticResource Dim}" Text="{Binding SelectedItem.PlayCast, ElementName=GolemList, Mode=OneWay}" TextWrapping="Wrap"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,4">
                                <Button Content="start" Click="Start_Click" Margin="0,0,12,0" ToolTip="start &lt;name&gt; — this golem's own start of the current play: pacman sets out, a ghost joins the hunt (the Pacman dialog writes it on every member's tab)"/>
                                <Button Content="over" Click="Over_Click" ToolTip="play over — the warden ends the play for the whole cast, at once (fase 4); a ghost touching pacman ends it by itself"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,4" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="Workspace › Pacman writes the board, the play and the start on every member's tab, each with its part; SEND and the game starts — pacman runs by itself, the ghosts hunt it"/>
                            <!-- EVERY PLAY TOLD (16-oct-2026; Juan: "la lista de las dinámicas de juegos de pacman u otros"): the golem's `plays` read, newest first -->
                            <TextBlock DockPanel.Dock="Top" Margin="6,2,6,2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" Text="PLAYS TOLD"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedItem.PlayList, ElementName=GolemList, Mode=OneWay}" Margin="6,0,6,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- a play of the list (16-oct-2026; Juan: "no se ve muy claro la lista… se deberían poder eliminar"): its name, kind and state as chips, who
                                                 ended it, the cast, and ✕ — forget play <name> on every member of the cast present here, after asking -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="#22ffffff" Padding="0,3">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding}" Click="ForgetPlay_Click" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="forget play — taken off every member's list, after asking (a running play: over first)"/>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Kind, Mode=OneWay}" FontSize="11"/></Border>
                                                            <Border>
                                                                <TextBlock Text="{Binding Drive, Mode=OneWay}" FontSize="11"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Drive}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Text="{Binding StateText, Mode=OneWay}" FontSize="11" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="{StaticResource Green}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOver}" Value="True"><Setter Property="Foreground" Value="{StaticResource Dim}"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,1,0,0" Text="{Binding CastText, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <!-- THE EXPLORATION (propuesta 120, 20-oct-2026; Juan: "un apartado de exploración y poder ir viendo el mapa que ha ido explorando, como
                         hacerle get a su mapa actual explorado"): the selected golem's `explored` read as a map of its own — the cells it deduced free
                         (teal) and wall (dark), the frontier of the unknown (rings), the golem where it stands — in the frame of its scenario, read with
                         the rest at every refresh; the console draws the hypothesis, it concludes nothing -->
                    <TabItem x:Name="ExplorationTab">
                        <TabItem.Header>
                            <TextBlock><Run Text="exploration"/><Run Text="{Binding SelectedItem.ExploredCount, ElementName=GolemList, Mode=OneWay, StringFormat=' ({0})'}"/></TextBlock>
                        </TabItem.Header>
                        <DockPanel Background="{StaticResource Well}">
                            <TextBlock DockPanel.Dock="Top" Margin="6,4,6,0" FontSize="11" Foreground="{StaticResource Ink}" Text="{Binding SelectedItem.ExploredText, ElementName=GolemList, Mode=OneWay}" TextWrapping="Wrap"/>
                            <!-- THE MODE (fase B; Juan: "uno inicia el modo exploración y él solo se queda ahí un tiempo indefinido hasta lograr explorar todo lo que
                                 encuentre"): explore / explore stop, at once on the selected golem; blind in the maze: use map blind first -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,4">
                                <Button Content="explore" Click="Explore_Click" Margin="0,0,4,0" ToolTip="explore — the exploration mode on, always blind: the golem blindfolds itself first (a scenario of its own with no map at all, blind-&lt;scenario&gt;, where its body stands — taken up again if it exists) and probes by itself, cell by cell into the unknown, until nothing unknown is left next to what it knows"/>
                                <Button Content="stop" Click="StopExploring_Click" Margin="0,0,12,0" ToolTip="explore stop — the mode off; a probe underway ends on its own: what was explored stays"/>
                                <Button Content="export map" Click="ExportMap_Click" Margin="0,0,4,0" ToolTip="export map &lt;name&gt; — the map deduced here becomes a scenario of the golem's own (named explored-&lt;scenario&gt;-&lt;n&gt;), listed in the maps tab: use map enters it, forget map drops it"/>
                                <Button Content="clear" Click="ClearExploration_Click" Margin="0,0,12,0" ToolTip="explore clear — what was explored here starts afresh: the trail and the marks gone (stopped first; it asks)"/>
                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Text="a probe is one step into the unknown; a touch ends it and the wall is learned"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,4" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="the map the golem deduced from where its body went and what it touched — free cells in teal, walls in dark red, the frontier of the unknown as rings; it grows with every arrival"/>
                            <Canvas x:Name="ExploredMap" Background="{StaticResource Well}" SizeChanged="ExploredMap_SizeChanged" ClipToBounds="True" Margin="6,0,6,6"/>
                        </DockPanel>
                    </TabItem>
                    <!-- THE GOLEM'S MAPS (propuesta 120; Juan: "otra pestaña con los mapas actuales y poder administrarlos a mi gusto… borrar algún mapa completo
                         del golem"): the `scenarios` read — a release's maps and the ones the explorer exported — each with 'use' (use map, at once) and,
                         for an exported one the golem is not in, a cross (forget map, after asking) -->
                    <TabItem x:Name="MapsTab">
                        <TabItem.Header>
                            <TextBlock><Run Text="maps"/><Run Text="{Binding SelectedItem.MapCount, ElementName=GolemList, Mode=OneWay, StringFormat=' ({0})'}"/></TextBlock>
                        </TabItem.Header>
                        <DockPanel Background="{StaticResource Well}">
                            <TextBlock DockPanel.Dock="Top" Margin="6,4,6,4" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="the maps the selected golem knows: its releases' and the ones it exported from an exploration — use enters one, the cross drops an exported one"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedItem.MapList, ElementName=GolemList}" Margin="4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="2,4">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="use" Tag="{Binding}" Click="UseMap_Click" Margin="0,0,4,0" ToolTip="use map — the golem enters this scenario now"/>
                                                        <Button Content="✕" Tag="{Binding}" Click="ForgetMap_Click" IsEnabled="{Binding CanDrop}" ToolTip="forget map — drops this exported map from the golem (asks first); a release's map stays, and the one the golem is in too"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,8,0"/>
                                                            <Border Style="{StaticResource Chip}">
                                                                <TextBlock Text="{Binding Kind, Mode=OneWay}" FontSize="11"/>
                                                            </Border>
                                                            <Border>
                                                                <TextBlock Text="in it now" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Current}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,1,0,0" Text="{Binding Text, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
</TabControl>
            </DockPanel>
        </GroupBox>
        <!-- the strip the debugger leaves when hidden: one click brings it back -->
        <Border x:Name="DebuggerStrip" Grid.Column="2" Visibility="Collapsed" Width="30" Margin="0,4,4,4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="ShowDebugger_Click" ToolTip="show the golem debugger (F9)">
            <TextBlock Text="◂  golem debugger" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>
    </Grid>
</Window>
