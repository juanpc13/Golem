<Window x:Class="WardenCli.Views.FormationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formation — told to the selected golem and its fleet" SizeToContent="Height" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="figure" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <StackPanel x:Name="Figures" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <RadioButton Content="square" IsChecked="True" Margin="0,0,10,0" Checked="Figure_Checked"/>
            <RadioButton Content="pentagon" Margin="0,0,10,0" Checked="Figure_Checked"/>
            <RadioButton Content="triangle" Margin="0,0,10,0" Checked="Figure_Checked"/>
            <RadioButton Content="circle" Margin="0,0,10,0" Checked="Figure_Checked"/>
            <RadioButton Content="propeller" Checked="Figure_Checked"
                         ToolTip="blades out of the centre, the golems along them from the hub to the tips; a step takes every golem to the next blade at its own distance (propuesta 114)"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="center x,y" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="CenterBox" Grid.Row="1" Grid.Column="1" Text="5.5,5.5"/>

        <TextBlock x:Name="MeasureLabel" Grid.Row="2" Text="side" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="MeasureBox" Grid.Row="2" Grid.Column="1" Text="2.0"/>

        <!-- THE PROPELLER'S HUB (propuesta 114): its inner radius, and its blades -->
        <TextBlock x:Name="InnerLabel" Grid.Row="3" Text="inner radius" VerticalAlignment="Center" Foreground="{StaticResource Dim}" Visibility="Collapsed"/>
        <DockPanel Grid.Row="3" Grid.Column="1">
            <!-- THE PROPELLER'S BLADES (propuesta 114): beside its hub -->
            <StackPanel x:Name="BladesPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                <TextBlock Text="blades" VerticalAlignment="Center" Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                <TextBox x:Name="BladesBox" Width="44" Text="3"/>
            </StackPanel>
            <TextBox x:Name="InnerBox" Text="1.0" Visibility="Collapsed"/>
        </DockPanel>

        <!-- THE POLICY is the formation's (propuesta 104: the formation is the golem's, and the golems share its places by rank — the names
             sorted — or by distance — who stands nearest, over their words) -->
        <TextBlock Grid.Row="4" Text="places shared by" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <RadioButton x:Name="ByRankBox" Content="rank (names sorted)" IsChecked="True" Margin="0,0,12,0"/>
            <RadioButton x:Name="ByDistanceBox" Content="distance (who stands nearest)" Margin="0,0,12,0" ToolTip="the golems say where they stand and share the places by the first law: the nearest pairs first"/>
            <RadioButton x:Name="ByGameBox" Content="rock-paper-scissors" ToolTip="who stands nearest — and when several want the same place, they play rock, paper, scissors for it; the disputes tab says who won and how (propuesta 115)"/>
        </StackPanel>

        <!-- THE CUE BETWEEN DANCERS (propuesta 117): the last of this fleet cues one golem of the next group when everybody finished; a formation
             that starts on cue gets no take — it waits, its steps queued, until one of its members is cued -->
        <TextBlock Grid.Row="6" Text="the cue" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="2,4">
            <CheckBox x:Name="OnCueBox" DockPanel.Dock="Right" Content="starts on cue (no take)" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="--on-cue: the formation waits, its steps queued, until the group before it cues one of its golems — then it dances all of it"/>
            <TextBlock DockPanel.Dock="Left" Text="when done, cue" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CueBox" Width="130" HorizontalAlignment="Left" ToolTip="--cue &lt;golem&gt;: the last of this fleet to finish tells that golem 'your turn' — a golem of the next group, chosen here"/>
        </DockPanel>

        <!-- THE PULL (propuesta 118): the formation starts after another, and its first golem by rank asks a golem of that group every tick whether it finished -->
        <TextBlock Grid.Row="7" Text="or ask" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <DockPanel Grid.Row="7" Grid.Column="1" Margin="2,4">
            <TextBlock DockPanel.Dock="Left" Text="starts after" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AfterBox" DockPanel.Dock="Left" Width="130" HorizontalAlignment="Left" Margin="0,0,14,0" ToolTip="--after &lt;formation&gt;: the formation waited for; no take — the pull: the first golem of this fleet asks every tick whether it finished"/>
            <TextBlock DockPanel.Dock="Left" Text="asking" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AskBox" DockPanel.Dock="Left" Width="130" HorizontalAlignment="Left" Margin="0,0,14,0" ToolTip="--ask &lt;golem&gt;: the golem asked, one of the other group"/>
            <TextBlock DockPanel.Dock="Left" Text="every" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="EveryBox" DockPanel.Dock="Left" Width="40" Text="5" ToolTip="--every &lt;seconds&gt;: how often the asker asks — a commitment of the golem's, kept by its attention when due (propuesta 121)"/>
            <TextBlock Text="s" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </DockPanel>

        <TextBlock x:Name="GolemsLabel" Grid.Row="5" Text="golems of the fleet" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,8,0"/>
        <ListBox x:Name="GolemsBox" Grid.Row="5" Grid.Column="1" Margin="2,6" SelectionMode="Multiple" Height="150"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="Problem" Foreground="{StaticResource Red}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="300"/>
            <Button Content="form in the selected golem" Click="Ok_Click" Style="{StaticResource GoGreen}" ToolTip="the form and take lines go on the selected golem's tab; the golem tells its fleet"/>
            <Button Content="cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
