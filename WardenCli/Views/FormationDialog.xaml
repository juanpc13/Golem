<Window x:Class="WardenCli.Views.FormationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formation — a figure laid out as queues" Height="380" Width="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="figure" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <StackPanel x:Name="Figures" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <RadioButton Content="square" IsChecked="True" Margin="0,0,10,0"/>
            <RadioButton Content="pentagon" Margin="0,0,10,0"/>
            <RadioButton Content="triangle" Margin="0,0,10,0"/>
            <RadioButton Content="circle"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="center x,y" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="CenterBox" Grid.Row="1" Grid.Column="1" Text="5.5,5.5"/>

        <TextBlock Grid.Row="2" Text="side (radius for a circle)" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="MeasureBox" Grid.Row="2" Grid.Column="1" Text="2.0"/>

        <!-- no steps, no sense, no pace (Juan, 8-oct-2026: "¿por qué tendríamos que especificar lo de clockwise a la hora de crear la formación?"):
             laying out puts every golem on its first vertex; the formation is turned afterwards, a step per click of ↻ ↺ -->
        <TextBlock Grid.Row="3" Text="places shared by" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <RadioButton x:Name="ByRankBox" Content="rank (names sorted)" IsChecked="True" Margin="0,0,12,0"/>
            <RadioButton Content="distance (where each stands now)" ToolTip="needs the last position of every golem: refresh first"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="golems (by rank: names sorted)" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
        <ListBox x:Name="GolemsBox" Grid.Row="4" Grid.RowSpan="2" Grid.Column="1" Margin="2,6" SelectionMode="Multiple" Height="150"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="Problem" Foreground="{StaticResource Red}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="append to the tabs" Click="Ok_Click" Style="{StaticResource GoGreen}"/>
            <Button Content="cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
