<Project Sdk="Microsoft.NET.Sdk">

  <!-- WardenCli — the operator's console as a DESKTOP program (propuesta 93, 6-oct-2026; Juan: "una aplicación de escritorio…
       básicamente el CLI pero… más bien es como un editor o IDE"): a toolbox at the top that composes commands, the golems in
       operation reached by host and port, a map with each golem where it was last asked, a vertical tab per golem with the script
       being built for it, a button to send it that golem's queue and one to send everybody's, workspaces and routine files, and
       formations the CLI itself lays out as queues of commands — apart from the golem's own choreography module, which stays.
       A thin CLIENT of the golem's HTTP surface (POST /command, GET /commands, GET /body); it decides nothing for the golem. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WardenCli</RootNamespace>
    <AssemblyName>WardenCli</AssemblyName>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

</Project>
