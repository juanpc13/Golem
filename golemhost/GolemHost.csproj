<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Choreography.dll (PerformanceV2) ships INSIDE this package.
         The FileSystem backend is part of the core: no adapter needed. -->
    <PackageReference Include="Ncubo.Puppeteer" Version="2.0.1-beta.10017-portable.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- TargetPath keeps it flat in the output: the root endpoint serves it as "panel.html" -->
    <None Include="Panel\panel.html" CopyToOutputDirectory="PreserveNewest" TargetPath="panel.html" />
  </ItemGroup>

</Project>
