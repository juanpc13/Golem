<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Choreography.dll (PerformanceV2) ships INSIDE this package.
         The FileSystem backend is part of the core: no adapter needed. -->
    <PackageReference Include="Ncubo.Puppeteer" Version="3.0.0-local.586d2c9" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure domain lives in its own assembly: sinks and hosts see it, it sees nothing of them. -->
    <ProjectReference Include="..\GolemDomain\GolemDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GolemTest" />
  </ItemGroup>

</Project>
