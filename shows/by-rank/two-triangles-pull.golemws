{
  "Kind": "golem workspace",
  "Version": 3,
  "Golems": [
    {
      "Name": "blue",
      "Host": "localhost",
      "Port": 8081,
      "Script": "use map road\r\nplace 3.0,3.0\r\n@sync\r\nplay road-4 traffic --light blue --cars cyan:south:straight,green:south:left,orange:north:right,red:north:straight,yellow:east:left --as light\r\nstart road-4"
    },
    {
      "Name": "red",
      "Host": "localhost",
