{
  "Kind": "golem workspace",
  "Version": 3,
  "Golems": [
    {
      "Name": "blue",
      "Host": "localhost",
      "Port": 8081,
      "Script": "use map road\nplace 3.0,3.0\nplay road-1 traffic --light blue --cars cyan:south:straight,green:south:left,orange:north:right,red:north:straight,yellow:east:left --as light\nstart road-1"
    },
    {
      "Name": "cyan",
