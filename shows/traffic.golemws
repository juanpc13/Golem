{
  "Kind": "golem workspace",
  "Version": 3,
  "Golems": [
    {
      "Name": "orange",
      "Host": "localhost",
      "Port": 8085,
      "Script": "use map road\nplace 3.0,3.0\nplay road-1 traffic --light orange --cars blue:south:left,red:south:straight,green:north:right,yellow:north:straight --as light\nstart road-1"
    },
    {
      "Name": "blue",
      "Host": "localhost",
