    { "Name": "red",    "Host": "localhost", "Port": 8082, "Script": "use map cross-corridors\nplace 5.5,10.0\nplay road-1 traffic --light orange --cars blue:left,red:straight,green:right --as car\nstart road-1" },
    { "Name": "green",  "Host": "localhost", "Port": 8083, "Script": "use map cross-corridors\nplace 9.5,5.5\nplay road-1 traffic --light orange --cars blue:left,red:straight,green:right --as car\nstart road-1" }
