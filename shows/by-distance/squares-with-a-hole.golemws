      "Port": 8081,
      "Script": "use map open-floor\nform sq-left square --center 3,5.5 --side 3 --angle 0 --fleet blue,green,red --by distance\ntake sq-left\n@sync\nrotate sq-left clockwise\n@sync\nrotate sq-left clockwise\n@sync\nrotate sq-left clockwise\n@sync\nrotate sq-left clockwise\n@sync"
