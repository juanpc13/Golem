<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pure domain: plain C# puppets, no Puppeteer, no ASP.NET, no I/O.
       Hosts reference it; it references no framework (domain-modeling guide E38) — only the libraries that
       CALCULATE for it (ajuste 89, 5-oct-2026; Juan: "no que nosotros hagamos los cálculos"): NetTopologySuite
       (the plane's geometry inside Position, Segment, Rectangle, the figures) and QuikGraph (the planner's Dijkstra).
       The domain names every operation in its own classes; the libraries never reach the journal.
       Namespaces: GolemDomain (the Golem aggregate the DSL instantiates),
       .Geometry (Position, Location, Segment, Pose, Rectangle), .Robots (Body, Mission),
       .Maps (Map, Area, Passage: information only), .Layouts (Layout, Zone, Wall, PlacedDoor,
       the Catalog: the map on the plane), .Touches (Collisions, Mark, Obstacle, Suspicion,
       HeardBump: what the bodies learned), .Routes (Trajectory, Leg, RoutePlanner, Maneuver).
       The engine binds classes by SIMPLE name: every class name must be unique. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GolemDomain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The acceptance tests chart the catalog's floor plans through the perform (FloorPlans.X().AsRelease). -->
    <InternalsVisibleTo Include="GolemTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
  </ItemGroup>

</Project>
