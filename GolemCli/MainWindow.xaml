<Window x:Class="GolemCli.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GolemCli"
        Title="GolemCli — the operator's console" Height="860" Width="1400" MinHeight="640" MinWidth="1060"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- a golem in the list: a box in its colour, like the sketch -->
        <DataTemplate x:Key="GolemBox">
            <Border x:Name="Box" BorderThickness="3" CornerRadius="3" Margin="4,3" Padding="6,4" Background="{StaticResource Well}" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}" Opacity="0.7"
                    ToolTip="click: this golem's script in the centre · check: addressed by 'selected'">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="selected: send and paste go to the selected golems"/>
                    <TextBlock x:Name="Marker" DockPanel.Dock="Right" Text="▶ script" Visibility="Collapsed" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource Ink}"><Run Text="{Binding Name}"/><Run Text="  "/><Run x:Name="Addr" Text="{Binding Address, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11" FontWeight="Normal"/></TextBlock>
                        <TextBlock Text="{Binding StatusLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="Seen" Text="{Binding LastSeen, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- the box whose script is in the centre: tinted in its golem's colour, its border a little thicker, a "script" tag in the accent;
                 the others dimmed (Juan, 7-oct-2026: "destacar el golem seleccionado… no se nota aún" — then, on a white border and a glow: "muy exagerado") -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="1"/>
                    <Setter TargetName="Box" Property="Background" Value="{Binding Name, Converter={x:Static local:GolemColor.Fill}}"/>
                    <Setter TargetName="Box" Property="BorderThickness" Value="4"/>
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Addr" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Seen" Property="Foreground" Value="{StaticResource Ink}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ScriptOf">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"><Run Text="the script for "/><Run Text="{Binding Name}" FontWeight="Bold" Foreground="#e6e1cf"/><Run Text=" — one command per line, sent in order; a line starting with # is a note"/></TextBlock>
                <!-- THE SEND COLUMN (Juan, 7-oct-2026: "sólo enviar a los selected… el stop debajo y posiciónalos hasta abajo"): one SEND, to the
                     checked golems, at the foot of the column with stop under it; which golems go is said by the checks, never by a button -->
                <DockPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Margin="4,4" Foreground="{StaticResource Dim}" TextWrapping="Wrap"><Run Text="sent "/><Run Text="{Binding Sent}"/><Run Text=" command(s) this session"/></TextBlock>
                    <Button DockPanel.Dock="Bottom" Content="stop" Click="StopSelected_Click" ToolTip="the checked golems that are sending stop; the rest of each queue stays on its tab"/>
                    <Button DockPanel.Dock="Bottom" Content="SEND to selected" Click="SendSelected_Click" Height="56" FontSize="15" FontWeight="Bold" Style="{StaticResource GoGreen}" ToolTip="the queue of every checked golem, each its own, line by line; they wait for each other at @sync"/>
                </DockPanel>
                <!-- ABOVE THE SCRIPT: what the golem can be told (Juan, 6-oct-2026: "algunos botones siempre por arriba y al centro el comando") -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,0,4">
                    <WrapPanel>
                        <TextBlock Text="errands" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
                        <Button Content="visit" Tag="visit {point}" Click="Compose_Click" ToolTip="visit x,y — go there, through every point picked on the map"/>
                        <Button Content="cover" Tag="cover {point}" Click="Compose_Click" ToolTip="cover x,y — the way decided at once"/>
                        <Button Content="then" Tag="then {point}" Click="Compose_Click" ToolTip="then x,y — one more stop on the route underway"/>
                        <TextBlock Text="hold" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Button Content="pause" Tag="pause" Click="Compose_Click"/>
                        <Button Content="resume" Tag="resume" Click="Compose_Click"/>
                        <TextBlock Text="levers" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Button Content="reset" Tag="reset" Click="Compose_Click" ToolTip="every route let go, the body back on its mark"/>
                        <Button Content="reset all" Tag="reset --all" Click="Compose_Click" ToolTip="reset --all: the journal wiped too"/>
                        <Button Content="place" Tag="place {point}" Click="Compose_Click" ToolTip="the body carried onto the point of the box"/>
                        <!-- the scenario is changed through the list the golem itself gives (Juan, 7-oct-2026: "por el mismo drop down que él nos proporciona
                             la lista de mapas que tiene, no tanto un botón de warehouse/openfloor"): picking one composes 'enter <scenario>' on the tab -->
                        <ComboBox Width="190" Tag="enter a scenario…" ItemsSource="{Binding ScenarioOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectionChanged="Scenario_Selected" ToolTip="the scenarios this golem knows, as it lists them — pick one and 'enter &lt;scenario&gt;' goes on the tab"/>
                    </WrapPanel>
                </Border>
                <!-- BELOW THE SCRIPT: the golem's own choreography module (the fleet agrees among itself) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,4,0,0">
                    <WrapPanel>
                        <TextBlock Text="its own choreography · centre: the point of the box" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <Button Content="square · by rank" Tag="choreograph square --center {point} --side 2.0 --by rank" Click="Compose_Click"/>
                        <Button Content="square · by distance" Tag="choreograph square --center {point} --side 2.0 --by distance" Click="Compose_Click"/>
                        <Button Content="pentagon · by distance" Tag="choreograph pentagon --center {point} --side 2.0 --by distance" Click="Compose_Click"/>
                        <Button Content="↻ clockwise" Tag="rotate clockwise" Click="Compose_Click"/>
                        <Button Content="↺ counter-clockwise" Tag="rotate counterclockwise" Click="Compose_Click"/>
                    </WrapPanel>
                </Border>
                <Border BorderThickness="3,0,0,0" BorderBrush="{Binding Name, Converter={x:Static local:GolemColor.Brush}}">
                    <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Margin="0"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap"/>
                </Border>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- THE RIBBON: our own, dark — tabs of groups of big buttons; every button composes a command on the current golem's tab -->
        <TabControl DockPanel.Dock="Top" x:Name="Ribbon" Style="{StaticResource RibbonTabs}" Height="152">
            <TabItem Header="Workspace">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="workspace" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="New" local:Look.Glyph="✧" Click="NewWorkspace_Click" ToolTip="a clean window: no golems, no scripts"/>
                            <Button Style="{StaticResource Big}" Content="Open…" local:Look.Glyph="📂" Click="OpenWorkspace_Click" ToolTip="a workspace folder: the golems, their queues, the routines"/>
                            <Button Style="{StaticResource Big}" Content="Save" local:Look.Glyph="💾" Click="SaveWorkspace_Click"/>
                            <Button Style="{StaticResource Big}" Content="Save as…" local:Look.Glyph="💾" local:Look.Tint="{StaticResource Accent}" Click="SaveWorkspaceAs_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="recent workspaces — click to switch" Style="{StaticResource RibbonGroup}">
                        <WrapPanel x:Name="RecentPanel" Orientation="Vertical" MaxHeight="96" VerticalAlignment="Top">
                            <TextBlock Text="none yet" Foreground="{StaticResource Dim}" Margin="4"/>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="program" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="About" local:Look.Glyph="ⓘ" Click="About_Click"/>
                            <Button Style="{StaticResource Big}" Content="Exit" local:Look.Glyph="⏻" local:Look.Tint="{StaticResource Red}" Click="Exit_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Console" IsSelected="True">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="clipboard" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Paste" local:Look.Glyph="📋" Click="Paste_Click" ToolTip="appends the clipboard's lines to this tab's script"/>
                            <Button Style="{StaticResource Big}" Content="Copy script" local:Look.Glyph="⎘" Click="Copy_Click" ToolTip="this tab's script to the clipboard"/>
                            <Button Style="{StaticResource Big}" Content="To selected" local:Look.Glyph="⇶" local:Look.Tint="{StaticResource Blue}" Click="CopyToSelected_Click" ToolTip="appends this tab's script to every checked golem's tab"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="routine files" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Save routine" local:Look.Glyph="💾" Click="SaveRoutine_Click" ToolTip="this tab's script as a .routine file"/>
                            <Button Style="{StaticResource Big}" Content="Load here" local:Look.Glyph="📂" Click="LoadRoutine_Click" ToolTip="a routine file appended to this tab"/>
                            <Button Style="{StaticResource Big}" Content="Load in selected" local:Look.Glyph="📂" local:Look.Tint="{StaticResource Blue}" Click="LoadRoutineSelected_Click" ToolTip="a routine file appended to every checked golem's tab"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="scripts" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Clear tab" local:Look.Glyph="✕" local:Look.Tint="{StaticResource Red}" Click="ClearTab_Click" ToolTip="this golem's script, emptied"/>
                            <Button Style="{StaticResource Big}" Content="Clear all tabs" local:Look.Glyph="✖" local:Look.Tint="{StaticResource Red}" Click="ClearAllTabs_Click" ToolTip="every golem's script, emptied — the queues that are sending are not touched"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="choreography by the console" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Formation" local:Look.Glyph="⬟" local:Look.Tint="{StaticResource Purple}" Click="Formation_Click" ToolTip="square, pentagon, triangle or circle: the console writes every golem's script — the places, the steps around"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="View">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="golems" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Big}" Content="Refresh" local:Look.Glyph="⟳" local:Look.Tint="{StaticResource Blue}" Click="Refresh_Click" ToolTip="ping every golem and ask where it stands"/>
                            <Button Style="{StaticResource Big}" Content="Journal" local:Look.Glyph="📖" Click="Journal_Click" ToolTip="follow the current golem's journal, live"/>
                            <Button Style="{StaticResource Big}" Content="Commands" local:Look.Glyph="?" Click="Commands_Click" ToolTip="the language the golem speaks"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- THE BOTTOM: the log, the journal of the current golem, the active formations -->
        <TabControl DockPanel.Dock="Bottom" Height="180" Margin="4" Style="{StaticResource DarkTabs}">
            <TabItem Header="log — what every golem answered">
                <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
            </TabItem>
            <TabItem x:Name="JournalTab" Header="journal">
                <TextBox x:Name="JournalBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
            </TabItem>
            <!-- THE ACTIVE FORMATIONS (propuesta 96, 7-oct-2026; Juan: "cuando uno cree una formación se cree una lista de formaciones activas… para
                 realizar las operaciones de rotar… un objeto que guarde el vértice que corresponde a cada golem"; "podrías moverlo a un tab"): every
                 formation laid out, who holds which vertex, and the rotations the operator asks of it — each writes a visit on every member's tab -->
            <TabItem x:Name="FormationsTab" Header="formations — the console's">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Left" Width="170" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock Text="steps per rotation" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBox x:Name="RotateSteps" DockPanel.Dock="Right" Width="36" Text="1" ToolTip="how many vertices each rotation moves everybody" TextAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="NoFormation" Text="none yet — Console › Formation lays one out and it appears here, with the vertex each golem holds; ↻ ↺ write the next visit on every member's tab" Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FormationList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="340" BorderThickness="1" BorderBrush="{StaticResource Purple}" CornerRadius="3" Margin="2,3" Padding="6,4" Background="{StaticResource Well}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  at "/><Run Text="{Binding Figure.Center, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/><Run Text="  turned "/><Run Text="{Binding Turned, Mode=OneWay}" Foreground="{StaticResource Dim}" FontWeight="Normal" FontSize="11"/></TextBlock>
                                            <TextBlock Text="{Binding Holders, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,2"/>
                                            <UniformGrid Columns="3">
                                                <Button Content="↻ step clockwise" Tag="{Binding}" Click="RotateClockwise_Click" ToolTip="everybody one vertex clockwise (down the figure's order): a visit on every member's tab"/>
                                                <Button Content="↺ step counter" Tag="{Binding}" Click="RotateCounter_Click" ToolTip="everybody one vertex counter-clockwise: a visit on every member's tab"/>
                                                <Button Content="dissolve" Tag="{Binding}" Click="Dissolve_Click" ToolTip="the formation leaves the list; the golems stay where they are"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- THE THREE COLUMNS: the golems (fixed), the script (grows), the golem debugger (a share of the window, so the map fits the
             resolution — Juan, 6-oct-2026: "el mapa como que no se ajusta muy bien a la resolución actual") -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="2*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- THE GOLEMS: boxes in their colour — the one clicked is the tab whose script the centre shows; a check addresses them together -->
            <GroupBox Grid.Column="0" Header="golems in operation — click one for its script">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <UniformGrid Columns="3">
                            <TextBox x:Name="NewName" ToolTip="name" Text="blue"/>
                            <TextBox x:Name="NewHost" ToolTip="host" Text="localhost"/>
                            <TextBox x:Name="NewPort" ToolTip="port" Text="8081"/>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Button Content="add" Click="AddGolem_Click"/>
                            <Button Content="remove" Click="RemoveGolem_Click"/>
                        </UniformGrid>
                        <Button Content="add the four of the compose" Click="AddFour_Click" ToolTip="blue 8081, red 8082, green 8083, yellow 8084 on localhost"/>
                    </StackPanel>
                    <ListBox x:Name="GolemList" ItemTemplate="{StaticResource GolemBox}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GolemList_SelectionChanged"/>
                </DockPanel>
            </GroupBox>

            <!-- THE CENTRE: the script of the golem clicked on the left; the script is its queue -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <ContentControl x:Name="Editor" Content="{Binding SelectedItem, ElementName=GolemList}" ContentTemplate="{StaticResource ScriptOf}"/>
                        <TextBlock x:Name="NoGolem" Text="add a golem on the left, click its box: its script is built here" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" x:Name="WorkspaceLabel" Margin="6,4" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Text="no workspace: the scripts live in this window until you save one"/>
            </Grid>

            <!-- THE RIGHT COLUMN IS ONE PANEL, THE GOLEM DEBUGGER (Juan, 7-oct-2026: "toda esa zona sea un solo panel, la del mapa, porque básicamente es la
                 lectura del golem; esa sección debería llamarse algo como debugger del golem porque hace lecturas junto con el mapa y permite crear los visit"):
                 what the selected golem knows (where, state, route, obstacles, asked every 3 s), its map with everybody and its obstacles, and the tool
                 that builds a command from a point — the map's clicks accumulate the visit's points -->
            <GroupBox Grid.Column="2">
                <GroupBox.Header>
                    <TextBlock x:Name="KnowsHeader" Text="golem debugger — select a golem: what it knows, its map, a command from a point" Foreground="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </GroupBox.Header>
                <DockPanel>
                    <!-- the reads, as information -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,4">
                        <ContentControl Content="{Binding SelectedItem, ElementName=GolemList}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WhereLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StateLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RouteLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding ObstaclesLine, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                    <!-- the tool: a point and a verb build one command; the points clicked on the map accumulate for visit and cover -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="x" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox DockPanel.Dock="Left" x:Name="XBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                <TextBlock DockPanel.Dock="Left" Text="y" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                <TextBox DockPanel.Dock="Left" x:Name="YBox" Width="56" Text="5.5" TextChanged="Point_Changed"/>
                                <TextBox x:Name="BuiltBox" FontFamily="Consolas" FontSize="14" IsReadOnly="True" Text="visit 5.5,5.5" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Left" x:Name="Verbs" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="the verb of the command built">
                                    <RadioButton Content="visit" IsChecked="True" Checked="Point_Changed" Margin="0,0,6,0"/>
                                    <RadioButton Content="cover" Checked="Point_Changed" Margin="0,0,6,0"/>
                                    <RadioButton Content="then" Checked="Point_Changed" Margin="0,0,6,0"/>
                                    <RadioButton Content="place" Checked="Point_Changed" Margin="0,0,6,0"/>
                                    <RadioButton Content="forget" Checked="Point_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="PointsHint" Text="click the map: every click adds a point to the visit, in order" Foreground="{StaticResource Dim}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="add to this tab" Click="AddBuilt_Click"/>
                                <Button Content="add to selected" Click="AddBuiltSelected_Click" ToolTip="the same command on every checked golem's tab"/>
                                <Button Content="copy" Click="CopyBuilt_Click" ToolTip="the command to the clipboard, to paste in another tab"/>
                                <Button Content="undo" Click="UndoPoint_Click" Margin="10,0,0,0" ToolTip="the last point clicked, taken back"/>
                                <Button Content="clear" Click="ClearPoints_Click" ToolTip="forget every point clicked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- the map, square and centred, with the height left -->
                    <TextBlock DockPanel.Dock="Top" x:Name="MapHeader" Text="map — the last position asked of each golem" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,0,2,2"/>
                    <Grid>
                        <Canvas x:Name="Map" Background="{StaticResource Well}" MouseLeftButtonDown="Map_Click" MouseMove="Map_MouseMove" MouseLeave="Map_MouseLeave" SizeChanged="Map_SizeChanged" ClipToBounds="True"/>
                        <!-- the coordinates under the cursor, while it is over the floor -->
                        <Border x:Name="Hover" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Background="#cc0f1419" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                            <TextBlock x:Name="HoverText" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="13"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
