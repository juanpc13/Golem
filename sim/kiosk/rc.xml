<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal openbox for kiosk mode: every window undecorated and pinned to (0,0);
     kiosk.sh maximizes Gazebo's window, so the picture IS the screen. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
</openbox_config>
